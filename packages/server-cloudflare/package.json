{
  "name": "@durable-streams/server-cloudflare",
  "version": "0.2.0",
  "description": "Durable Streams protocol server on Cloudflare Workers + Durable Objects — export the StreamObject class and mount the handler in your own Worker",
  "license": "Apache-2.0",
  "author": "Tom Beckenham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/durable-streams/durable-streams.git",
    "directory": "packages/server-cloudflare"
  },
  "bugs": {
    "url": "https://github.com/durable-streams/durable-streams/issues"
  },
  "keywords": [
    "durable-streams",
    "cloudflare",
    "workers",
    "durable-objects",
    "streams",
    "sse",
    "resumable"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "scripts": {
    "cf-typegen": "wrangler types --config test/wrangler.jsonc",
    "build": "pnpm cf-typegen && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "conformance": "cd ../.. && vitest run --project server-cloudflare"
  },
  "devDependencies": {
    "@durable-streams/server-conformance-tests": "workspace:*",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.1"
  }
}
